# ==============================================================================
# RouteX / NER-LINK Environment Configuration Template (.env.example)
#
# Copy this file to .env and configure values appropriate for your environment:
#   cp .env.example .env
#
# IMPORTANT:
# - NEVER commit the real .env file or production secrets to source control.
# - In production, supply secrets via your cloud/orchestrator secret manager.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application Settings
# ------------------------------------------------------------------------------
# [Required] Environment mode: 'development', 'test', or 'production'
APP_ENV=development
APP_NAME=RouteX
APP_DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL 16 + PostGIS)
# ------------------------------------------------------------------------------
# [Required] Database user, password, and database name
POSTGRES_USER=nerlink_user
# Placeholder: Use a strong, unique password in non-local environments
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=nerlink
# Host and port:
# - For local host development (outside Docker): POSTGRES_HOST=localhost, POSTGRES_PORT=55432
# - Inside Docker Compose network: POSTGRES_HOST=db, POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_PORT=55432

# ------------------------------------------------------------------------------
# 3. Redis Cache & Event Streams
# ------------------------------------------------------------------------------
# - For local host development (outside Docker): REDIS_HOST=localhost, REDIS_PORT=56379
# - Inside Docker Compose network: REDIS_HOST=redis, REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_PORT=56379
REDIS_DB=0

# ------------------------------------------------------------------------------
# 4. Authentication & JWT Security
# ------------------------------------------------------------------------------
# [Required in Production] Cryptographically random secret key (minimum 32 characters)
# Generate in bash: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_min_32_char_cryptographically_secure_jwt_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Development-only identity headers (X-User-Role, X-User-Id).
# MUST be false in production (enforced by startup validator)
ALLOW_DEV_AUTH_HEADERS=true

# Refresh Token Cookie (HttpOnly)
REFRESH_COOKIE_NAME=rx_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_HTTPONLY=true
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth

# Rate Limiting for Login Attempts
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# ------------------------------------------------------------------------------
# 5. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list or JSON array of allowed origins for web clients.
# NOTE: Wildcard '*' is strictly prohibited in production when credentials are enabled.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 6. Administrator Account Credentials & Provisioning
# ------------------------------------------------------------------------------
# Administrator account credentials. When configured, RouteX ensures this admin
# account exists on startup. You can use ADMIN_EMAIL / ADMIN_PASSWORD.
ADMIN_EMAIL=admin@routex.ai
ADMIN_PASSWORD=replace_with_secure_initial_admin_password
ADMIN_NAME=RouteX Administrator

# Alias variants (also supported by CLI & settings):
ADMIN_BOOTSTRAP_EMAIL=admin@routex.ai
ADMIN_BOOTSTRAP_PASSWORD=replace_with_secure_initial_admin_password
ADMIN_BOOTSTRAP_NAME=RouteX Administrator

# ------------------------------------------------------------------------------
# 7. Geographic Corridor Scope & Routing
# ------------------------------------------------------------------------------
CORRIDOR_NAME=Guwahati-Tawang
CORRIDOR_MIN_LAT=26.10
CORRIDOR_MIN_LON=91.50
CORRIDOR_MAX_LAT=27.70
CORRIDOR_MAX_LON=92.80

OSM_NETWORK_TYPE=drive
OSM_DATA_DIR=data/osm

# ------------------------------------------------------------------------------
# 8. External Integrations & Evidence Storage
# ------------------------------------------------------------------------------
MEDIA_DIR=data/evidence
MAX_UPLOAD_SIZE_BYTES=15728640
INCIDENT_ROAD_MATCH_RADIUS_M=150.0

# Weather Ingestion (Open-Meteo)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_REQUEST_TIMEOUT_SECONDS=10.0
WEATHER_REFRESH_INTERVAL_MINUTES=60
WEATHER_SAMPLE_GRID_STEP_DEG=0.5

# GPS Telemetry Ingestion
GPS_SNAP_THRESHOLD_M=100.0
GPS_MAX_SPEED_KMH=250.0
GPS_BATCH_MAX_SIZE=200

# ML Processing
ML_CLAIM_TIMEOUT_MINUTES=15
ML_SERVICE_ROLE=ml_service

# Satellite Ingestion Adapter
SATELLITE_PROVIDER=copernicus_sentinel2
SATELLITE_MAX_CLOUD_COVER_PERCENT=40.0
