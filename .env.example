# ==========================================
# NER-LINK Environment Configuration
# ==========================================

# Application
APP_ENV=development
APP_NAME=NER-LINK
APP_DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL + PostGIS)
# Default host port 55432 avoids conflicts with existing local PostgreSQL instances
POSTGRES_USER=nerlink_user
POSTGRES_PASSWORD=nerlink_secure_password
POSTGRES_DB=nerlink
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
# Inside docker-compose networks, use POSTGRES_HOST=db and POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=56379
REDIS_DB=0
# Inside docker-compose networks, use REDIS_HOST=redis and REDIS_PORT=6379

# Study Corridor Configuration (Provisional demo: Guwahati to Tawang corridor)
# Configurable bounding box: min_lat (South), min_lon (West), max_lat (North), max_lon (East)
CORRIDOR_NAME=Guwahati-Tawang
CORRIDOR_MIN_LAT=26.10
CORRIDOR_MIN_LON=91.50
CORRIDOR_MAX_LAT=27.70
CORRIDOR_MAX_LON=92.80

# OSM Ingestion Network Type (drive, all_private, etc.)
OSM_NETWORK_TYPE=drive
OSM_DATA_DIR=data/osm

# Evidence Storage & Image Management
MEDIA_DIR=data/evidence
MAX_UPLOAD_SIZE_BYTES=15728640
INCIDENT_ROAD_MATCH_RADIUS_M=150.0

# Weather Ingestion (Open-Meteo)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_REQUEST_TIMEOUT_SECONDS=10.0
WEATHER_REFRESH_INTERVAL_MINUTES=60
WEATHER_SAMPLE_GRID_STEP_DEG=0.5

# GPS & Telemetry Ingestion
GPS_SNAP_THRESHOLD_M=100.0
GPS_MAX_SPEED_KMH=250.0
GPS_BATCH_MAX_SIZE=200

# ML Handoff Contract
ML_CLAIM_TIMEOUT_MINUTES=15
ML_SERVICE_ROLE=ml_service

# Satellite Ingestion Adapter
SATELLITE_PROVIDER=copernicus_sentinel2
SATELLITE_MAX_CLOUD_COVER_PERCENT=40.0

# Authentication & JWT Security
# In production, replace JWT_SECRET_KEY with a cryptographically random string (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=nerlink_super_secret_jwt_key_at_least_32_chars_long_2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOW_DEV_AUTH_HEADERS=true
REFRESH_COOKIE_NAME=nerlink_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

